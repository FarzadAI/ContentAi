{
  "name": "tabaghe-manfi-yek",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "طبقه منفی یک — پلتفرم انتخاب، مقایسه و ارزیابی آموزش",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
